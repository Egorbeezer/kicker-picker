{
  "name": "kicker-picker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "npm run build && playwright test",
    "deploy": "npm run build && tgcloud push",
    "deploy:support": "cd support-bot && ../node_modules/.bin/tgcloud push",
    "bot:menu": "tgcloud run endpoints/setupBotMenu '{}'",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "unslop:check": "python3 .agents/skills/unslop-ui/scripts/count_tells.py --surface src index.html",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tgcloud/cli": "^0.2.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
